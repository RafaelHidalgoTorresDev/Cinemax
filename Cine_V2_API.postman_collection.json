{
	"info": {
		"_postman_id": "cine-v2-jwt-collection",
		"name": "🎬 Cine V2 API - JWT",
		"description": "Colección completa de la API del Cine con autenticación JWT.\n\n📌 **Uso:**\n1. Ejecuta el Login para obtener automáticamente el token\n2. Todas las peticiones protegidas lo usarán automáticamente\n3. Usa el Refresh Token cuando el Access Token expire",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"variable": [
		{
			"key": "base_url",
			"value": "http://localhost:8080",
			"type": "string"
		},
		{
			"key": "access_token",
			"value": "",
			"type": "string"
		},
		{
			"key": "refresh_token",
			"value": "",
			"type": "string"
		}
	],
	"auth": {
		"type": "bearer",
		"bearer": [
			{
				"key": "token",
				"value": "{{access_token}}",
				"type": "string"
			}
		]
	},
	"item": [
		{
			"name": "🔓 URLs Públicas (Sin Token)",
			"item": [
				{
					"name": "📝 Registro",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"if (pm.response.code === 201) {",
									"    var jsonData = pm.response.json();",
									"    pm.collectionVariables.set('access_token', jsonData.accessToken);",
									"    pm.collectionVariables.set('refresh_token', jsonData.refreshToken);",
									"    console.log('✅ Tokens guardados automáticamente desde registro');",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"auth": {
							"type": "noauth"
						},
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"email\": \"usuario@cine.com\",\n    \"password\": \"password123\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/api/v1/auth/register",
							"host": ["{{base_url}}"],
							"path": ["api", "v1", "auth", "register"]
						}
					}
				},
				{
					"name": "🔑 Login",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"if (pm.response.code === 200) {",
									"    var jsonData = pm.response.json();",
									"    pm.collectionVariables.set('access_token', jsonData.accessToken);",
									"    pm.collectionVariables.set('refresh_token', jsonData.refreshToken);",
									"    console.log('✅ Access Token y Refresh Token guardados automáticamente');",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"auth": {
							"type": "noauth"
						},
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"email\": \"admin@cine.com\",\n    \"password\": \"admin123\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/api/v1/auth/login",
							"host": ["{{base_url}}"],
							"path": ["api", "v1", "auth", "login"]
						}
					}
				},
				{
					"name": "🏓 Ping (Test Público)",
					"request": {
						"auth": {
							"type": "noauth"
						},
						"method": "GET",
						"url": {
							"raw": "{{base_url}}/api/test/ping",
							"host": ["{{base_url}}"],
							"path": ["api", "test", "ping"]
						}
					}
				},
				{
					"name": "🎬 Ver Cartelera (Públicas)",
					"request": {
						"auth": {
							"type": "noauth"
						},
						"method": "GET",
						"url": {
							"raw": "{{base_url}}/api/v1/peliculas",
							"host": ["{{base_url}}"],
							"path": ["api", "v1", "peliculas"]
						}
					}
				},
				{
					"name": "🕐 Ver Funciones/Horarios (Públicas)",
					"request": {
						"auth": {
							"type": "noauth"
						},
						"method": "GET",
